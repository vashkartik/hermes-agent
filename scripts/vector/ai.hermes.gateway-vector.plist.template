<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd job for the VECTOR profile gateway, pinned to the profile-scoped
     runtime. Render by replacing @RUNTIME@ (checkout dir containing venv/)
     and @PROFILE_HOME@ before installing to ~/Library/LaunchAgents/. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.hermes.gateway-vector</string>
    <key>ProgramArguments</key>
    <array>
        <string>@RUNTIME@/venv/bin/python</string>
        <string>-m</string>
        <string>hermes_cli.main</string>
        <string>--profile</string>
        <string>vector</string>
        <string>gateway</string>
        <string>run</string>
        <string>--replace</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HERMES_HOME</key>
        <string>@PROFILE_HOME@</string>
        <key>VIRTUAL_ENV</key>
        <string>@RUNTIME@/venv</string>
        <key>PATH</key>
        <string>@RUNTIME@/venv/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>@PROFILE_HOME@</string>
    <key>StandardOutPath</key>
    <string>@PROFILE_HOME@/logs/gateway.log</string>
    <key>StandardErrorPath</key>
    <string>@PROFILE_HOME@/logs/gateway.error.log</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>ExitTimeOut</key>
    <integer>25</integer>
    <key>LimitLoadToSessionType</key>
    <array>
        <string>Aqua</string>
        <string>Background</string>
    </array>
</dict>
</plist>
